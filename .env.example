# Calendblade environment. Copy to .env.local for development.
# Never commit real values. Defaults below work with `docker compose up -d`.

# ── Core ─────────────────────────────────────────────────────────────────────
# Postgres connection. Neon URLs (*.neon.tech) use the Neon serverless driver;
# anything else uses postgres.js.
DATABASE_URL=postgres://calendblade:calendblade@localhost:5433/calendblade
# Direct (unpooled) URL for migrations; optional, falls back to DATABASE_URL.
DATABASE_URL_UNPOOLED=
# Public base URL of the app (used for OAuth redirects, emails and webhooks).
NEXT_PUBLIC_APP_URL=http://localhost:3100

# ── Auth (Better Auth) ───────────────────────────────────────────────────────
# At least 32 characters. Generate: openssl rand -base64 48
BETTER_AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-chars
# Same origin as NEXT_PUBLIC_APP_URL.
BETTER_AUTH_URL=http://localhost:3100

# ── Google OAuth ─────────────────────────────────────────────────────────────
# Optional in development (demo accounts work without it). Required to sign in
# with Google and to connect real Google calendars. See docs/self-hosting.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Security secrets ─────────────────────────────────────────────────────────
# AES-256-GCM key for provider tokens: exactly 32 bytes, base64.
# Generate: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
# Signs the calendar-connection OAuth state (min 32 chars). openssl rand -base64 48
CONNECTION_STATE_SECRET=
# Derives Google push-channel tokens (min 32 chars). openssl rand -base64 48
WEBHOOK_SECRET=

# ── Cron ─────────────────────────────────────────────────────────────────────
# Your scheduler sends `Authorization: Bearer <CRON_SECRET>` to /api/cron/*.
# Min 16 chars. Generate: openssl rand -hex 24
CRON_SECRET=
# Time budget per cron invocation in ms (keep below your platform's limit).
CRON_BUDGET_MS=50000

# ── Billing (optional) ───────────────────────────────────────────────────────
# false (default): billing disabled, every account has unlimited calendars and
# rules (self-host mode). true: all STRIPE_* values are required.
BILLING_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_MAX_MONTHLY=

# ── Email ────────────────────────────────────────────────────────────────────
# resend | smtp | log (log = print to console, development only)
EMAIL_TRANSPORT=smtp
# Required for EMAIL_TRANSPORT=smtp. Mailpit from docker-compose: smtp://localhost:1025
SMTP_URL=smtp://localhost:1025
# Required for EMAIL_TRANSPORT=resend.
RESEND_API_KEY=
EMAIL_FROM="Calendblade <hello@calendblade.localhost>"

# ── Observability (optional, opt-in) ─────────────────────────────────────────
# Nothing is sent anywhere unless these are set.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Build-time source map upload (only used when a DSN is set).
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
# Server-side product analytics.
POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com
# Browser analytics.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ── Localization ─────────────────────────────────────────────────────────────
# Comma-separated locales offered to users (others stay routable for testing).
PUBLIC_LOCALES=en

# ── Brand and legal identity ─────────────────────────────────────────────────
# Forks must use their own name; the Calendblade name and logo are not licensed.
NEXT_PUBLIC_BRAND_NAME=Calendblade
NEXT_PUBLIC_SUPPORT_EMAIL=support@example.com
NEXT_PUBLIC_LEGAL_ENTITY_NAME=Your Company Ltd.
NEXT_PUBLIC_LEGAL_ADDRESS=
# Privacy contact and Data Protection Officer / Encarregado (LGPD). Defaults to the support email.
NEXT_PUBLIC_PRIVACY_EMAIL=
NEXT_PUBLIC_DPO_NAME=
# EU representative (GDPR Art. 27), only if you serve the EU without an EU establishment.
NEXT_PUBLIC_EU_REPRESENTATIVE=
# Governing law of the terms of service, e.g. Brazil.
NEXT_PUBLIC_LEGAL_JURISDICTION=
# Optional legal fields left empty are omitted from the legal pages.
NEXT_PUBLIC_REPOSITORY_URL=https://github.com/andrebrito16/calendblade

# ── Development only (rejected when NODE_ENV=production) ─────────────────────
# In-memory demo calendar provider ("Connect demo account").
PROVIDER_FIXTURE=1
# Exposes the last magic link per email at /api/dev/magic-link.
DEV_MAGIC_LINK_ENDPOINT=1
# Set to 1 to build without secrets (CI, Docker image builds).
# SKIP_ENV_VALIDATION=1
